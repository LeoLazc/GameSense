{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "Http",
    "QuizProvider": "Http",
    "BaseUrl": "https://your-ai-gateway.example/",
    "QuizEvaluationPath": "quiz/evaluate",
    "Model": "gpt-4o-mini",
    "ApiKey": ""
  },
  "GameCatalog": {
    "Provider": "Rawg",
    "ApiBaseUrl": "https://api.rawg.io/api/",
    "ApiKey": "",
    "EnableDevelopmentStartupSync": false
  },
  "Jwt": {
    "Issuer": "GameSense.Api",
    "Audience": "GameSense.Client",
    "ExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=GameSenseDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
