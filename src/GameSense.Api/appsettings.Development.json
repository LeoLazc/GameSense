{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "development-only-key-replace-with-user-secrets-32-bytes"
  },
  "Ai": {
    "Provider": "Http",
    "QuizProvider": "Http",
    "BaseUrl": "https://your-ai-gateway.example/",
    "QuizEvaluationPath": "quiz/evaluate",
    "ApiKey": ""
  },
  "GameCatalog": {
    "Provider": "Rawg",
    "ApiBaseUrl": "https://api.rawg.io/api/",
    "ApiKey": "",
    "EnableDevelopmentStartupSync": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
